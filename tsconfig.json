{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // vitest.config.ts pulls in Node's types; fixtures/tsconfig.json checks it (ADR-0096).
  "include": ["apps/*/src", "apps/*/test", "packages/*/src"],
  // DOM types collide with workers-types; apps/web has its own tsconfig.
  "exclude": ["apps/web"]
}
