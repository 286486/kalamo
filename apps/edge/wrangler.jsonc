{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zibel",
  "main": "src/index.ts",
  // Must not be later than the workerd bundled with @cloudflare/vitest-plugin.
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  // pathkit-wasm's Emscripten loader takes nodejs_compat's process for Node and reads __dirname,
  // which an ES module Worker lacks. It never loads a file: the wasm is handed over (ADR-0034).
  "define": { "__dirname": "\"/\"" },
  // The bundled font as bytes (ADR-0013); skill:// documents as text.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  // The web app (built by `pnpm dev`); the Worker answers /mcp and /api first.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DOCUMENT", "class_name": "DocumentObject" }]
  },
  // `wrangler d1 create zibel --binding DB --update-config` replaces this id for hosting.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zibel",
      "database_id": "bfad6d7b-8e8a-4b69-93e5-d7d00958c16f",
      "migrations_dir": "migrations"
    }
  ],
  // Image files, one object per file per Document (ADR-0046); wrangler dev and tests emulate it.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "zibel-images" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentObject"] }],
  // `token=actor` pairs in apps/edge/.dev.vars locally and an encrypted Worker secret remotely.
  "secrets": { "required": ["DEV_TOKENS"] }
}
