{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kalamo",
  "main": "src/index.ts",
  // Must not be later than the workerd bundled with @cloudflare/vitest-plugin.
  "compatibility_date": "2026-09-21",
  // global_fetch_strictly_public: the SSRF guard that MCP OAuth's Client ID Metadata Documents need.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // pathkit-wasm's Emscripten loader takes nodejs_compat's process for Node and reads __dirname,
  // which an ES module Worker lacks. It never loads a file: the wasm is handed over (ADR-0034).
  "define": { "__dirname": "\"/\"" },
  // The bundled fonts as bytes (ADR-0013, ADR-0063); skill:// documents as text.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf", "**/*.otf"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  // The web app (built by `pnpm dev`); the Worker answers /mcp, /api, /auth and OAuth's routes first.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/api/*", "/auth/*", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DOCUMENT", "class_name": "DocumentObject" }]
  },
  // `wrangler d1 create kalamo --binding DB --update-config` replaces this id for hosting.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kalamo",
      "database_id": "108560f3-fa33-4816-885f-db1a2e68f197",
      "migrations_dir": "migrations"
    }
  ],
  // Image files, one object per file per Document (ADR-0046); wrangler dev and tests emulate it.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "kalamo-images" }],
  // MCP OAuth grants and tokens, hashed and encrypted by workers-oauth-provider (ADR-0047).
  // `wrangler kv namespace create kalamo-oauth --binding OAUTH_KV --update-config` replaces this id.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "3f0564ab74d940089087907628b44310" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentObject"] }],
  // Deployed Workers sign browsers in with GitHub (ADR-0047), unless the deploy passes
  // `--var AUTH_MODE:dev`, as the hosted one does for now (README). `.dev.vars` sets `dev` locally;
  // the GitHub secrets, APP_ORIGIN and MCP_ORIGIN are Worker secrets.
  "vars": { "AUTH_MODE": "github" }
}
