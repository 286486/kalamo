{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zibel",
  "main": "src/index.ts",
  // Must not be later than the workerd bundled with @cloudflare/vitest-plugin.
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  // The bundled font as bytes (ADR-0013); skill:// documents as text.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  // The web app (built by `pnpm dev`); the Worker answers /mcp and /api first.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DOCUMENT", "class_name": "DocumentObject" }]
  },
  // Local only until M1 creates the hosted database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zibel",
      "database_id": "bfad6d7b-8e8a-4b69-93e5-d7d00958c16f",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentObject"] }],
  // Dev tokens for local Agent Actors, `token=actor` pairs. Replaced by OAuth in M1.
  "vars": {
    "DEV_TOKENS": "dev-token-a=agent-a,dev-token-b=agent-b"
  }
}
